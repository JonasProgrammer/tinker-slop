if(NOT DEFINED JSTS_TOOL OR NOT DEFINED JSTS_TEST_DIR)
    message(FATAL_ERROR "missing test arguments")
endif()
file(REMOVE_RECURSE "${JSTS_TEST_DIR}")
file(MAKE_DIRECTORY "${JSTS_TEST_DIR}")
function(jsts_run JSTS_EXPECTED)
    execute_process(COMMAND "${JSTS_TOOL}" ${ARGN}
        RESULT_VARIABLE JSTS_RESULT OUTPUT_VARIABLE JSTS_STDOUT ERROR_VARIABLE JSTS_STDERR)
    if(NOT JSTS_RESULT STREQUAL "${JSTS_EXPECTED}")
        message(FATAL_ERROR "unexpected CLI exit status: ${JSTS_RESULT}, expected ${JSTS_EXPECTED}")
    endif()
    if(JSTS_STDOUT MATCHES "fixture-secret" OR JSTS_STDERR MATCHES "fixture-secret")
        message(FATAL_ERROR "secret appeared in diagnostics")
    endif()
endfunction()
set(JSTS_INPUT "${JSTS_TEST_DIR}/input.cfg")
set(JSTS_SAFE "${JSTS_TEST_DIR}/safe.cfg")
set(JSTS_MAP "${JSTS_TEST_DIR}/map.json")
set(JSTS_RESTORED "${JSTS_TEST_DIR}/restored.cfg")
file(WRITE "${JSTS_INPUT}" "interfaces { ethernet eth0 { pppoe 0 { user-id user\npassword \"fixture-secret\"\n} } }\n")
jsts_run(0 --help)
jsts_run(2 redact)
jsts_run(2 restore --input "${JSTS_INPUT}" --output "${JSTS_RESTORED}" --map "${JSTS_MAP}" --escape invalid)
jsts_run(2 redact --input "${JSTS_INPUT}" --output "${JSTS_SAFE}" --map "${JSTS_MAP}" --escape raw)
jsts_run(3 redact --input "${JSTS_INPUT}" --output "${JSTS_INPUT}" --map "${JSTS_MAP}")
jsts_run(0 redact --input "${JSTS_INPUT}" --output "${JSTS_SAFE}" --map "${JSTS_MAP}")
jsts_run(3 redact --input "${JSTS_INPUT}" --output "${JSTS_SAFE}" --map "${JSTS_MAP}")
jsts_run(0 restore --input "${JSTS_SAFE}" --output "${JSTS_RESTORED}" --map "${JSTS_MAP}")
file(READ "${JSTS_INPUT}" JSTS_BEFORE)
file(READ "${JSTS_RESTORED}" JSTS_AFTER)
if(NOT JSTS_BEFORE STREQUAL JSTS_AFTER)
    message(FATAL_ERROR "CLI round trip failed")
endif()
file(READ "${JSTS_MAP}" JSTS_MAPPING)
string(JSON JSTS_SENTINEL GET "${JSTS_MAPPING}" secrets 1 sentinel)
file(WRITE "${JSTS_TEST_DIR}/routeros.safe" "/interface pppoe-client add password=\"${JSTS_SENTINEL}\"\n")
jsts_run(0 restore --input "${JSTS_TEST_DIR}/routeros.safe" --output "${JSTS_TEST_DIR}/routeros.rsc"
    --map "${JSTS_MAP}" --escape routeros-value)
file(READ "${JSTS_TEST_DIR}/routeros.rsc" JSTS_ROUTEROS)
if(NOT JSTS_ROUTEROS STREQUAL "/interface pppoe-client add password=\"fixture-secret\"\n")
    message(FATAL_ERROR "RouterOS restore failed")
endif()
file(WRITE "${JSTS_TEST_DIR}/bad.cfg" "a {")
jsts_run(4 redact --input "${JSTS_TEST_DIR}/bad.cfg" --output "${JSTS_TEST_DIR}/bad.safe" --map "${JSTS_TEST_DIR}/bad.map")
if(EXISTS "${JSTS_TEST_DIR}/bad.safe" OR EXISTS "${JSTS_TEST_DIR}/bad.map")
    message(FATAL_ERROR "malformed source produced output")
endif()
file(WRITE "${JSTS_TEST_DIR}/unknown.cfg" "JSTS_SECRET_v1_UNKNOWN_PASSWORD_000001")
jsts_run(6 restore --input "${JSTS_TEST_DIR}/unknown.cfg" --output "${JSTS_TEST_DIR}/unknown.out" --map "${JSTS_MAP}")
file(WRITE "${JSTS_TEST_DIR}/bad.json" "{}")
jsts_run(5 restore --input "${JSTS_SAFE}" --output "${JSTS_TEST_DIR}/bad.out" --map "${JSTS_TEST_DIR}/bad.json")
file(CREATE_LINK "${JSTS_INPUT}" "${JSTS_TEST_DIR}/alias.cfg" RESULT JSTS_LINK_RESULT)
if(JSTS_LINK_RESULT STREQUAL "0")
    jsts_run(3 redact --input "${JSTS_INPUT}" --output "${JSTS_TEST_DIR}/alias.cfg" --map "${JSTS_TEST_DIR}/alias.map")
endif()
file(CREATE_LINK "${JSTS_INPUT}" "${JSTS_TEST_DIR}/symlink.cfg" SYMBOLIC RESULT JSTS_LINK_RESULT)
if(JSTS_LINK_RESULT STREQUAL "0")
    jsts_run(3 redact --input "${JSTS_INPUT}" --output "${JSTS_TEST_DIR}/symlink.cfg" --map "${JSTS_TEST_DIR}/symlink.map")
endif()
jsts_run(3 redact --input "${JSTS_TEST_DIR}" --output "${JSTS_TEST_DIR}/dir.safe" --map "${JSTS_TEST_DIR}/dir.map")
